{
  "name": "prospect-model",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape:drafts": "npx ts-node --project scripts/tsconfig.json scripts/1-scrape-drafts.ts",
    "scrape:college": "npx ts-node --project scripts/tsconfig.json scripts/2-scrape-college-stats.ts",
    "scrape:nba": "npx ts-node --project scripts/tsconfig.json scripts/3-scrape-nba-careers.ts",
    "scrape:combine": "npx ts-node --project scripts/tsconfig.json scripts/4-scrape-combine.ts",
    "scrape:combine:bref": "npx ts-node --project scripts/tsconfig.json scripts/4b-scrape-combine-bref.ts",
    "scrape:teams": "npx ts-node --project scripts/tsconfig.json scripts/8-scrape-team-stats.ts",
    "build:dataset": "npx ts-node --project scripts/tsconfig.json scripts/5-build-dataset.ts",
    "train": "npx ts-node --project scripts/tsconfig.json scripts/6-train-model.ts",
    "predict": "npx ts-node --project scripts/tsconfig.json scripts/7-predict-class.ts",
    "pipeline": "npm run scrape:drafts && npm run scrape:college && npm run scrape:nba && npm run scrape:combine && npm run build:dataset && npm run train && npm run predict"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
